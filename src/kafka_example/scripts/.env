# Kafka Configuration
KAFKA_VERSION=3.7.0
KAFKA_NODE1_PORT=9092
KAFKA_NODE2_PORT=9095
KAFKA_NODE3_PORT=9096

# UI Ports
KAFDROP_PORT=9000
KAFKA_MANAGER_PORT=9001

# Database
POSTGRES_PORT=5432
POSTGRES_DB=order_management
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# Redis
REDIS_PORT=6379

# Resource limits
KAFKA_MEMORY_LIMIT=2g
KAFKA_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m